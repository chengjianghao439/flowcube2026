{
  "name": "flowcube",
  "private": true,
  "description": "仓库根脚本（tag / 工具），业务包见 frontend、desktop、backend",
  "scripts": {
    "pretag": "bash scripts/git-tag-check.sh",
    "release:tag-desktop": "bash scripts/release-desktop-tag.sh",
    "release:prod": "bash scripts/release-prod.sh",
    "release:gate": "bash scripts/release-gate.sh",
    "release:check-downloads": "node scripts/check-deprecated-downloads.js",
    "generate:status": "node scripts/generate-status-constants.js",
    "deploy:keygen": "bash scripts/setup-deploy-key.sh",
    "test:label": "node tests/label-geometry.test.js && node tests/label-zpl.test.js && node tests/label-geometry-frontend.test.js",
    "test:print": "node tests/print-policy.test.js && node tests/print-status.test.js",
    "test:print-purge": "node tests/print-jobs-purge.test.js",
    "test:oplog": "node tests/oplogger.test.js",
    "test:permissions": "node tests/permission-codes.test.js",
    "test:accounting": "node tests/accounting-voucher-mapping.test.js",
    "test:audit-tooling": "node --test tests/audit-tooling.test.js tests/audit-deployment.test.js",
    "test:audit-client": "node --test tests/audit-desktop.test.js tests/audit-return-putaway.test.js tests/audit-pda-publish.test.js",
    "smoke:audit-inventory": "node tests/audit-inventory.smoke.test.js",
    "smoke:audit-finance-security": "node tests/audit-finance-security.smoke.test.js",
    "smoke:accounting": "node tests/accounting.smoke.test.js",
    "smoke:accounting-period": "node tests/accounting-period.smoke.test.js",
    "smoke:concurrency-guards": "node tests/concurrency-guards.smoke.test.js",
    "smoke:sale-adjustment": "node tests/sale-adjustment.smoke.test.js",
    "smoke:atp": "node tests/sale-atp.smoke.test.js",
    "smoke:p0-regression": "node tests/p0-regression.smoke.test.js",
    "smoke:p1-regression": "node tests/p1-regression.smoke.test.js",
    "smoke:warehouse-scope": "node tests/warehouse-scope.smoke.test.js",
    "smoke:pda-device-session": "node tests/pda-device-session.smoke.test.js",
    "smoke:finance": "node tests/finance.smoke.test.js",
    "smoke:invoice-quota": "node tests/invoice-quota.smoke.test.js",
    "smoke:refund-orders": "node tests/refund-orders.smoke.test.js",
    "smoke:disposal": "node tests/disposal.smoke.test.js",
    "smoke:mainline": "node tests/mainline.smoke.test.js",
    "test:integration": "node tests/integration.test.js",
    "smoke:reports": "npm --prefix backend run smoke:reports",
    "smoke:reports-values": "node tests/reports-values.smoke.test.js",
    "smoke:credit-outbound": "node tests/credit-outbound.smoke.test.js",
    "smoke:purchase-approval": "node tests/purchase-approval.smoke.test.js",
    "smoke:approval-flow": "node tests/approval-flow.smoke.test.js",
    "smoke:credit-override": "node tests/credit-override.smoke.test.js",
    "check:schema": "node backend/scripts/schema-reconcile.js",
    "test:hr-tax": "node tests/hr-tax.smoke.test.js",
    "smoke:pages": "node scripts/smoke-pages.node.js",
    "smoke:reconciliation": "bash scripts/smoke-reconciliation-jumps.sh"
  }
}
