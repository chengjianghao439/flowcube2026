{
  "name": "flowcube",
  "private": true,
  "description": "仓库根脚本（tag / 工具），业务包见 frontend、desktop、backend",
  "scripts": {
    "pretag": "bash scripts/git-tag-check.sh",
    "release:tag-desktop": "bash scripts/release-desktop-tag.sh",
    "release:prod": "bash scripts/release-prod.sh",
    "release:gate": "bash scripts/release-gate.sh",
    "release:check-downloads": "node scripts/check-deprecated-downloads.js",
    "generate:status": "node scripts/generate-status-constants.js",
    "deploy:keygen": "bash scripts/setup-deploy-key.sh",
    "test:label": "node tests/label-geometry.test.js && node tests/label-zpl.test.js && node tests/label-geometry-frontend.test.js",
    "test:print": "node tests/print-policy.test.js && node tests/print-status.test.js",
    "test:permissions": "node tests/permission-codes.test.js",
    "smoke:concurrency-guards": "node tests/concurrency-guards.smoke.test.js",
    "smoke:sale-adjustment": "node tests/sale-adjustment.smoke.test.js",
  "smoke:p0-regression": "node tests/p0-regression.smoke.test.js",
  "smoke:p1-regression": "node tests/p1-regression.smoke.test.js",
  "smoke:warehouse-scope": "node tests/warehouse-scope.smoke.test.js",
  "smoke:pda-device-session": "node tests/pda-device-session.smoke.test.js",
  "smoke:pda-device-session-strict": "PDA_SESSION_REQUIRED=1 node tests/pda-device-session.smoke.test.js",
    "smoke:mainline": "node tests/mainline.smoke.test.js",
    "test:integration": "node tests/integration.test.js",
    "smoke:reports": "npm --prefix backend run smoke:reports",
    "smoke:pages": "bash scripts/smoke-pages.sh",
    "smoke:reconciliation": "bash scripts/smoke-reconciliation-jumps.sh"
  }
}
