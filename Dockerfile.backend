FROM node:20-alpine
# 非 root 运行（P2-13）：node 镜像自带 node 用户 + su-exec 工具。
# entrypoint 以 root 启动（仅做挂载目录 chown 这一件需要权限的事），
# 然后降权到 node 用户跑业务进程——业务进程不持有 root 权限。
RUN apk add --no-cache su-exec && mkdir -p /app && chown -R node:node /app
WORKDIR /app
COPY backend/package*.json ./
RUN npm ci --omit=dev
COPY --chown=node:node backend/ .
COPY --chown=node:node docker/backend-entrypoint.sh /usr/local/bin/backend-entrypoint.sh
RUN chmod +x /usr/local/bin/backend-entrypoint.sh
EXPOSE 3000
ENTRYPOINT ["/usr/local/bin/backend-entrypoint.sh"]
