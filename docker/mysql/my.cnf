[mysqld]
# 【时区固化 2026-08-27】MySQL 服务端会话/默认时区 = 北京时间偏移。
# 官方 mysql:8.0 镜像默认 UTC，NOW()/CURRENT_TIMESTAMP 生成的 created_at 等会与
# 后端连接池 timezone=+08:00 的读写字面量差 8 小时。default-time-zone 用偏移量
# 格式（不查 mysql.time_zone 表，无需加载时区数据）：
#   - NOW()/CURRENT_TIMESTAMP 默认值 → 北京字面量
#   - 连接池按 +08:00 解析该字面量 → 时间轴正确、两端一致
# 配套：docker-compose.yml 给 mysql 容器加 TZ=Asia/Shanghai（system_time_zone 与
# 日志时间戳显示），server-update.sh 在部署时显式 up -d mysql 让配置生效。
default-time-zone = '+08:00'
# 慢查询日志（P2-14）：记录执行超过阈值的 SQL，供排查性能瓶颈。
slow_query_log = ON
slow_query_log_file = /var/log/mysql/slow.log
long_query_time = 2
# 2026-08-21：不再用 log_queries_not_using_indexes 记录无索引查询。
# 该开关是监控噪音的元凶——把 0.0004 秒、扫 1 行的普通查询全部记成"慢查询"，
# 12 天攒了 10.9 万条 / 83M，让 monitor.sh 的"慢查询≥50 条"告警永远触发、形同虚设。
# 真实慢查询仍由 long_query_time=2 记录；无索引查询的性能问题由代码审查与
# EXPLAIN 排查，不靠日志堆。

# 连接数上限（与 backend 连接池 DB_POOL_SIZE 配套，默认 30，留余量）
max_connections = 151
