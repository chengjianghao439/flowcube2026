# Local credentials and deployment secrets never belong in the build context.
**/.env
**/.env.*
**/.npmrc
**/*.pem
**/*.key
**/*.p12
**/*.jks
**/*.keystore
deploy/production*.json
deploy/*.local.json
tests/seedTestData.js
tests/resetBusinessData.js

# Reinstall dependencies and build frontend assets inside the image.
**/node_modules
**/dist
**/.vite
**/.gradle
frontend/android
desktop/release
backend/downloads
backend/apk/*.apk
backend/apk/published-version.json
backend/apk/.publish-pda*
frontend/.pda-server-url

# Repository metadata, tools, local logs, backups, and test output.
.git
.agents
.claude
.codex
.superpowers
.idea
.vscode
**/.DS_Store
**/*.log
**/__pycache__
**/*.pyc
**/.playwright-cli
**/coverage
**/playwright-report
**/test-results
**/*.tmp
**/*.bak
**/*.sql.gz
backups
flowcube_backup.sql
.tmp-flowcube-downloads
TEMP_BRAND_SYNC
security-scan-report*
gitleaks-report.json
