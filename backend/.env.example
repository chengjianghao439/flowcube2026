# 服务配置
PORT=3000
NODE_ENV=development

# 数据库配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=flowcube
DB_PASSWORD=replace_with_local_password
DB_NAME=flowcube

# JWT 配置
JWT_SECRET=replace_with_a_random_string_at_least_32_chars_long
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=30d
JWT_SECRET_PREVIOUS=
DB_POOL_SIZE=30
# 尚未取得连接时最多等待5秒；超期返回503，不派发排队SQL。
DB_ACQUIRE_TIMEOUT_MS=5000
# 配置后仅上报未知异常；不自动采集 HTTP/SQL/请求体
SENTRY_DSN=

# 首次启用管理员账号时，可配合 `npm run bootstrap:admin` 使用
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
# ADMIN_REAL_NAME=系统管理员

# 登录限流（POST /api/auth/login，按 IP；反代后请设 TRUST_PROXY=1）
# AUTH_LOGIN_MAX_PER_IP=300
# AUTH_LOGIN_WINDOW_MS=900000

# CORS 配置
CORS_ORIGIN=http://localhost:5173
# CORS_ORIGIN 支持逗号分隔的精确来源；生产 Web 与内置 Android PDA 示例：
# CORS_ORIGIN=https://your-domain.com,https://localhost
# Electron file:// 的 Origin 是字符串 null，按需单独允许：
# CORS_ALLOW_NULL_ORIGIN=1
# CORS_REFLECT=0
# 开发环境默认允许 null（除非 CORS_ALLOW_NULL_ORIGIN=0）
#
# ⚠️ 生产安全提示（2026-08-30 审计）：CORS_REFLECT=1 会把任意 Origin 反射为
# Access-Control-Allow-Origin 且 credentials:true。本系统用 Bearer token（存 sessionStorage，
# 浏览器不自动携带），CSRF 风险低；但若未来退化到 Cookie 会话，此组合即构成完整 CSRF。
# 生产使用精确来源列表；CORS_REFLECT=1 或 CORS_ORIGIN=* 是兼容开关，会允许任意来源。

# 桌面端更新（0.3.5 等旧版只会用接口返回的 url 下载；须同域 HTTPS + 服务器上已有 exe）
# APP_PUBLIC_URL=https://your-domain.com   # 生产环境必填；缺失时后端会直接拒绝启动，避免更新链半残运行
# TRUST_PROXY=1                            # 前面有 Nginx/反代时建议开启，否则下载链接可能错成 http://
# APP_UPDATE_USE_GITHUB_DIRECT_URL=        # 设为 1 时仍返回 GitHub 直链（境内一般不要开）
# APP_UPDATE_DOWNLOADS_DIR=/var/www/flowcube-downloads
# APP_UPDATE_MANIFEST_PATH=        # 默认 ${APP_UPDATE_DOWNLOADS_DIR}/latest.json

# 仅排障：500 时在接口 message 中返回真实异常（勿长期对公网开启）
# APP_EXPOSE_ERRORS=1

# 入库逐包收货后打印容器标签（可选）：
# - 填写时：与「打印机管理」中的编码 code 一致
# - 不填：自动选用第一台在线且类型为「标签打印机」的记录
# INBOUND_LABEL_PRINTER_CODE=

# ── 本地脚本 tests/integration.test.js、tests/concurrency.stress.test.js（勿把密码写入仓库）──
# TEST_DB_PASSWORD=
# TEST_DB_HOST=127.0.0.1
# TEST_DB_USER=flowcube
# TEST_DB_NAME=flowcube
# TEST_API_HOST=localhost
# TEST_API_PORT=3000

# ── 日志集中检索（P2-12）──
# 配置后 warn/error 级日志异步推送 Grafana Loki（fire-and-forget，不阻塞业务）。
# 需先 docker compose --profile observability up -d 起 loki/grafana，再填：
# LOKI_URL=http://loki:3100/loki/api/v1/push
# GRAFANA_ADMIN_PASSWORD=change_me   # 起 observability profile 前务必设置（未设则用默认弱密码，仅本机实验用）

# 顺丰/德邦官方月结直连。密钥只放服务端，开通步骤见 docs/direct-express-2026-09-06.md。
# 默认为沙箱；确认权限、产品与回执后，正式配置 MODE=production。
WAYBILL_SF_MAIN_APP_ID=
WAYBILL_SF_MAIN_APP_KEY=
WAYBILL_SF_MAIN_MODE=sandbox
WAYBILL_SF_MAIN_API_BASE=https://sfapi-sbox.sf-express.com/std/service
WAYBILL_DEPPON_MAIN_APP_ID=
WAYBILL_DEPPON_MAIN_APP_KEY=
WAYBILL_DEPPON_MAIN_MODE=sandbox
# 德邦下单/查询 HTTPS URL 由开放平台分配，不填写第三方网关。
WAYBILL_DEPPON_MAIN_API_BASE=
WAYBILL_DEPPON_MAIN_QUERY_API_BASE=
WAYBILL_DEPPON_MAIN_ORDER_PREFIX=
# 顺丰 totalWeight 和德邦 packageInfo.totalWeight 均由系统默认传 1（kg），无需重量配置。

# 快递账号绑定页：由管理员按合同配置可读的顺丰服务名称；仓库人员只选择名称。
# 示例仅表示结构，不代表账号已开通该产品：[{"code":"合同产品编码","label":"日常普快"}]
WAYBILL_SF_MAIN_PRODUCTS=[]
# 完成正式平台授权与实际回执验收后，才登记对应月结号（逗号分隔）。
# 清单只用于简易绑定页的启用校验，不是官方在线授权查询；不得填未验收账号。
WAYBILL_SF_MAIN_VERIFIED_MONTHLY_ACCOUNTS=
WAYBILL_DEPPON_MAIN_VERIFIED_MONTHLY_ACCOUNTS=
