# 构建阶段
FROM node:22-alpine AS builder
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ .
RUN npm run build

# 运行阶段 — Nginx 静态服务
FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY docker/nginx-00-map.conf /etc/nginx/conf.d/00-map.conf
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# 移除官方入口脚本 10-listen-on-ipv6-by-default.sh（2026-09-18 线上故障根因）。
# 该脚本启动时会执行 `apk manifest nginx | grep ... | cut ...` 计算 default.conf 的校验和，
# 而在 Alpine 3.24.2 / apk-tools 3.0.8（nginx:alpine 在 2026-09-18 滚动到的版本）上
# `apk manifest` 会**永久挂住**（实测 timeout 后 exit=143，有网无网都一样）；上一版基础镜像
# Alpine 3.24.1 / apk-tools 3.0.6 正常。后果是入口脚本卡死、nginx 永不启动：容器状态 running
# 但 80 端口无人监听，docker-proxy 对进来的连接回 RST → 部署的前端健康检查连续超时 → 整次发布
# 回退（v0.9.22 首次部署就是这样失败的）。
# 我们自带 conf.d/default.conf，且不依赖该脚本注入 `listen [::]:80`，直接删掉最稳，
# 也免得下次基础镜像再出同类问题时又炸一次。
RUN rm -f /docker-entrypoint.d/10-listen-on-ipv6-by-default.sh

EXPOSE 80
