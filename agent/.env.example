# 极序 Agent 环境变量示例（复制为部署环境变量，勿把真实 key 提交进仓库）
# 正式 Flow 的 API 地址（Agent 只走 Flow 正式 API，不连数据库）
FLOW_BASE_URL=https://your-flow.example.com
# Agent 服务监听端口
AGENT_PORT=8932
# 模型（BYOK）：OpenAI 兼容接口的 base / key / 模型名。名称只由部署环境的 AGENT_MODEL_NAME 注入，示例不写死。
AGENT_MODEL_BASE_URL=https://api.deepseek.com
AGENT_MODEL_API_KEY=<在部署环境注入，勿写进仓库>
AGENT_MODEL_NAME=
# 预览有效期毫秒（默认 10 分钟，一般不改）
# AGENT_PREVIEW_TTL_MS=600000
