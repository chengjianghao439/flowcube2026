# FlowCube 根目录 Docker / 部署环境样例
# 使用方式：
#   cp .env.example .env
#   按需修改后再执行 docker compose up -d

# MySQL 容器与后端共享的数据库配置
MYSQL_ROOT_PASSWORD=replace_with_local_root_password
DB_NAME=flowcube
DB_USER=flowcube
DB_PASSWORD=replace_with_local_app_password
MYSQL_PORT=3306

# 后端运行配置
PORT=3000
DB_HOST=mysql
DB_PORT=3306
JWT_SECRET=replace_with_a_random_string_at_least_32_chars_long
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=30d
JWT_SECRET_PREVIOUS=
DB_POOL_SIZE=30
# 尚未取得连接时最多等待5秒；超期返回503，不派发排队SQL。
DB_ACQUIRE_TIMEOUT_MS=5000
# 配置后仅上报未知异常；不自动采集 HTTP/SQL/请求体
SENTRY_DSN=
CORS_ORIGIN=http://localhost:5173
# 生产示例（需部署支持来源列表的后端）：https://your-domain.com,https://localhost
# Electron file:// 按需设置 CORS_ALLOW_NULL_ORIGIN=1；生产保持 CORS_REFLECT=0。
CORS_REFLECT=0
CORS_ALLOW_NULL_ORIGIN=0
TRUST_PROXY=0
APP_PUBLIC_URL=                     # 生产环境必填；缺失时后端会直接拒绝启动
# 钉钉经营预警（v0.5.0 功能）：填钉钉群机器人 webhook 后，逾期应收应付/低于补货点/
# 临期批次/呆滞库存每 30 分钟扫描并推送到群；留空则静默不推送
# DINGTALK_ALERT_SECRET：加签密钥（推荐，机器人安全设置选「加签」时必填）
DINGTALK_ALERT_WEBHOOK=
DINGTALK_ALERT_SECRET=
APP_UPDATE_DOWNLOADS_DIR=/var/www/flowcube-downloads
FLOWCUBE_DOWNLOADS_DIR=/var/www/flowcube-downloads

# 官方快递正式连接（只进入后端容器）。按官网分配信息一次性设置；密钥不得提交。
# 页面用户只填写月结账号、合同服务和德邦送货方式，并显式启用自动下单。
WAYBILL_SF_MAIN_APP_ID=
WAYBILL_SF_MAIN_APP_KEY=
WAYBILL_SF_MAIN_MODE=production
WAYBILL_SF_MAIN_API_BASE=https://sfapi.sf-express.com/std/service
# 可选覆盖；默认内置顺丰特快、顺丰标快，页面按合同选择。
WAYBILL_SF_MAIN_PRODUCTS=[]
# 仅登记已完成正式授权/联调验收的月结账号，英文逗号分隔。
WAYBILL_SF_MAIN_VERIFIED_MONTHLY_ACCOUNTS=
# 德邦 APP_ID 为 companyCode；ORDER_PREFIX 为平台 sign，与月结账号分开。
WAYBILL_DEPPON_MAIN_APP_ID=
WAYBILL_DEPPON_MAIN_APP_KEY=
WAYBILL_DEPPON_MAIN_MODE=production
# 以下两个地址必须使用德邦正式配置的 HTTPS 地址，不能填之前的 HTTP 测试入口。
WAYBILL_DEPPON_MAIN_API_BASE=
WAYBILL_DEPPON_MAIN_QUERY_API_BASE=
WAYBILL_DEPPON_MAIN_ORDER_PREFIX=
WAYBILL_DEPPON_MAIN_VERIFIED_MONTHLY_ACCOUNTS=

# 发布门禁必须显式注入以下两组烟雾账号凭据，勿提交真实值；CI 使用同名 Secrets。
SMOKE_USERNAME=
SMOKE_PASSWORD=
# 长期保留的受限验收账号，仅授予 dashboard.view / inbound.order.view，用于 403 和授权页面对照检查。
SMOKE_LIMITED_USERNAME=
SMOKE_LIMITED_PASSWORD=

# 首次启用管理员账号时，可配合 `npm --prefix backend run bootstrap:admin` 使用
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
# ADMIN_REAL_NAME=系统管理员

# 桌面/PDA 构建环境变量（按需导出给前端构建命令）
# VITE_ERP_PRODUCTION_ORIGIN=        # build-time default；runtime override 统一使用 API_BASE_URL
# VITE_PDA_FALLBACK_API_ORIGIN=
